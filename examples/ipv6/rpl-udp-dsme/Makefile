all: node
CONTIKI=../../..

CFLAGS += -DPROJECT_CONF_H=\"project-conf.h\"

MODULES += core/net/mac/dsme

CONTIKI_WITH_IPV6 = 1
CFLAGS += -DMAKE_FOR_M3=1

ifdef DSME
CFLAGS += -DDSME
else
ifdef CSMA
CFLAGS += -DCSMA
else
$(error Neither DSME nor CSMA defined)
endif
endif


ifdef RATE
# rate to send udp messages defined in milliseconds
CFLAGS += -DPERIOD=$(RATE)
else
CFLAGS += -DPERIOD=1500
endif
ifdef PAN_COORDINATOR
CFLAGS += -DPAN_COORDINATOR=$(PAN_COORDINATOR)
else
$(error No PAN_COORDINATOR specified)
endif

ifdef DSME_CAP_REDUCTION
CFLAGS += -DDSME_CAP_REDUCTION=$(DSME_CAP_REDUCTION)
else
ifdef DSME
$(error No DSME_CAP_REDUCTION specified)
else
# irrelevant for CSMA, but build error otherwise
CFLAGS += -DDSME_CAP_REDUCTION=0
endif
endif

ifdef DSME_MO
CFLAGS += -DDSME_MO=$(DSME_MO)
else
ifdef DSME
$(error No DSME_MO specified)
else
# irrelevant for CSMA, but build error otherwise
CFLAGS += -DDSME_MO=0
endif
endif


ifdef DSME_ADAPTIVE_MO_ENABLE
CFLAGS += -DDSME_ADAPTIVE_MO_ENABLE=$(DSME_ADAPTIVE_MO_ENABLE)
endif
ifdef DSME_ADAPTIVE_MO_MIN
CFLAGS += -DDSME_ADAPTIVE_MO_MIN=$(DSME_ADAPTIVE_MO_MIN)
endif
ifdef DSME_ADAPTIVE_MO_MAX
CFLAGS += -DDSME_ADAPTIVE_MO_MAX=$(DSME_ADAPTIVE_MO_MAX)
endif
ifdef DSME_FINAL_STATE_SNAPSHOT_SECONDS
CFLAGS += -DDSME_FINAL_STATE_SNAPSHOT_SECONDS=$(DSME_FINAL_STATE_SNAPSHOT_SECONDS)
endif
ifdef APP_TRAFFIC_STOP_SECONDS
CFLAGS += -DAPP_TRAFFIC_STOP_SECONDS=$(APP_TRAFFIC_STOP_SECONDS)
endif
ifdef APP_HIGH_DEADLINE_MS
CFLAGS += -DAPP_HIGH_DEADLINE_MS=$(APP_HIGH_DEADLINE_MS)
endif
ifdef APP_LOW_DEADLINE_MS
CFLAGS += -DAPP_LOW_DEADLINE_MS=$(APP_LOW_DEADLINE_MS)
endif

ifdef ADAPTIVE_MO_DEMO
CFLAGS += -DADAPTIVE_MO_DEMO=$(ADAPTIVE_MO_DEMO)
endif

ifdef ADAPTIVE_MO_GRACE
CFLAGS += -DDSME_ADAPTIVE_MO_STARTUP_GRACE_WINDOWS=$(ADAPTIVE_MO_GRACE)
endif

ifdef ADAPTIVE_MO_MIN
CFLAGS += -DDSME_ADAPTIVE_MO_MIN=$(ADAPTIVE_MO_MIN)
endif

ifdef ADAPTIVE_MO_MAX
CFLAGS += -DDSME_ADAPTIVE_MO_MAX=$(ADAPTIVE_MO_MAX)
endif

ifdef ADAPTIVE_MO_PHASE_SECONDS
CFLAGS += -DADAPTIVE_MO_PHASE_SECONDS=$(ADAPTIVE_MO_PHASE_SECONDS)
endif

ifdef ADAPTIVE_MO_DEMAND_MS
CFLAGS += -DADAPTIVE_MO_DEMAND_INTERVAL_MS=$(ADAPTIVE_MO_DEMAND_MS)
endif

ifdef ADAPTIVE_MO_DEMAND_SLOTS
CFLAGS += -DADAPTIVE_MO_DEMAND_SLOTS=$(ADAPTIVE_MO_DEMAND_SLOTS)
endif

# Test-only deterministic protocol fault hooks. These have no effect unless a
# fault experiment explicitly passes the corresponding make variables.
ifdef ADAPTIVE_MO_FAULT_PHASE
CFLAGS += -DADAPTIVE_MO_FAULT_PHASE=$(ADAPTIVE_MO_FAULT_PHASE)
endif
ifdef ADAPTIVE_MO_FAULT_PEER
CFLAGS += -DADAPTIVE_MO_FAULT_PEER=$(ADAPTIVE_MO_FAULT_PEER)
endif
ifdef ADAPTIVE_MO_FAULT_COUNT
CFLAGS += -DADAPTIVE_MO_FAULT_COUNT=$(ADAPTIVE_MO_FAULT_COUNT)
endif
ifdef ADAPTIVE_MO_FAIL_APPLY_MOTE
CFLAGS += -DADAPTIVE_MO_FAIL_APPLY_MOTE=$(ADAPTIVE_MO_FAIL_APPLY_MOTE)
endif
ifdef ADAPTIVE_MO_FAIL_ACT_ROLLBACK_MOTE
CFLAGS += -DADAPTIVE_MO_FAIL_ACT_ROLLBACK_MOTE=$(ADAPTIVE_MO_FAIL_ACT_ROLLBACK_MOTE)
endif
ifdef ADAPTIVE_MO_FAIL_SAB_ROLLBACK_MOTE
CFLAGS += -DADAPTIVE_MO_FAIL_SAB_ROLLBACK_MOTE=$(ADAPTIVE_MO_FAIL_SAB_ROLLBACK_MOTE)
endif

include $(CONTIKI)/core/net/mac/dsme/Makefile.dsme
